# Keep source and configuration files consistent across operating systems.
* text=auto eol=lf

# Keep the GitHub language summary focused on the LaTeX note sources.
*.py linguist-detectable=false
Makefile linguist-detectable=false

# Tracked example/reference PDFs and bundled assets are binary.
# Generated course PDFs are ignored rather than tracked or stored with Git LFS.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.otf binary
*.ttf binary

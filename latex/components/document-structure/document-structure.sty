\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{\@currpath\@currname}[2026/08/01 v0.1.0 Document structure]

\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}
\KOMAoptions{numbers=noenddot}

\setkomafont{disposition}{\sffamily\color{unipd-primary}}
\setkomafont{chapter}{\bfseries\fontsize{22pt}{26pt}\selectfont}
\setkomafont{section}{\bfseries\fontsize{17pt}{21pt}\selectfont}
\setkomafont{subsection}{\unipdsanssemibold\fontsize{14pt}{17pt}\selectfont}
\setkomafont{subsubsection}{\unipdsanssemibold\fontsize{11.5pt}{14pt}\selectfont}
\renewcommand*{\chapterformat}{\thechapter\autodot\enskip}

\newcommand*{\unipdheadingafterskip}{0.35\baselineskip}
\RedeclareSectionCommand[beforeskip=0pt,afterskip=\unipdheadingafterskip]{chapter}
\RedeclareSectionCommand[beforeskip=1.5\baselineskip,afterskip=\unipdheadingafterskip]{section}
\RedeclareSectionCommand[beforeskip=1.1\baselineskip,afterskip=\unipdheadingafterskip]{subsection}
\RedeclareSectionCommand[beforeskip=0.9\baselineskip,afterskip=\unipdheadingafterskip]{subsubsection}

\addto\captionsitalian{%
  \renewcommand*{\appendixname}{\unipdtranslate{appendix}}}
\addto\captionsenglish{%
  \renewcommand*{\appendixname}{\unipdtranslate{appendix}}}
\NewDocumentCommand{\courseappendices}{}{\clearpage\appendix}

\endinput

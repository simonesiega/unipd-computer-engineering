\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{\@currpath\@currname}[2026/07/31 v0.1.0 Algorithms]

\RequirePackage[linesnumbered,algochapter]{algorithm2e}

\SetAlgorithmName
  {\unipdtranslate{algorithm}}
  {\unipdtranslate{algorithms}}
  {\unipdtranslate{list-of-algorithms}}
\SetAlgoCaptionSeparator{.\enskip}
\newcommand{\unipdalgocaptionlayout}[1]{\centering#1}
\SetAlgoCaptionLayout{unipdalgocaptionlayout}
\SetAlCapFnt{\sffamily\fontsize{9pt}{11pt}\selectfont}
\SetAlCapNameFnt{\sffamily\bfseries\color{unipd-primary}}
\SetAlCapHSkip{0pt}
\SetAlCapSkip{\smallskipamount}
\newcommand{\unipdalgofont}{\normalfont\ttfamily\fontsize{9.5pt}{12pt}\selectfont}
\SetAlFnt{\unipdalgofont}
\newcommand{\unipdalgokeyword}[1]{{\bfseries\color{unipd-primary}#1}}
\SetKwSty{unipdalgokeyword}
\SetArgSty{texttt}
\SetAlgoNlRelativeSize{0}
\SetNlSkip{9pt}
\SetNlSty{texttt}{\color{unipd-muted!75!black}}{}
\SetAlgoVlined
\DontPrintSemicolon
\RestyleAlgo{boxed}
\AtBeginEnvironment{algorithm}{%
  \setcounter{AlgoLine}{0}%
  \IncMargin{2em}%
}

\SetKwInput{KwInput}{\unipdtranslate{input}}
\SetKwInput{KwOutput}{\unipdtranslate{output}}
\let\unipd@KwOutput\KwOutput
\renewcommand{\KwOutput}[1]{\unipd@KwOutput{#1}\BlankLine}
\SetKw{Return}{\unipdtranslate{return}}
\SetKw{KwTo}{\unipdtranslate{to}}
\SetKw{KwAnd}{\unipdtranslate{and}}
\SetKw{KwOr}{\unipdtranslate{or}}
\SetKwFor{For}
  {\unipdtranslate{for}}
  {\unipdtranslate{do}}
  {\unipdtranslate{end}}
\SetKwFor{While}
  {\unipdtranslate{while}}
  {\unipdtranslate{do}}
  {\unipdtranslate{end}}
\SetKwIF{If}{ElseIf}{Else}
  {\unipdtranslate{if}}
  {\unipdtranslate{then}}
  {\unipdtranslate{else-if}}
  {\unipdtranslate{else}}
  {\unipdtranslate{end}}
\SetKwProg{Function}
  {\unipdtranslate{function}}
  {:}
  {\unipdtranslate{end}}


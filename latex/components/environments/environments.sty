\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{\@currpath\@currname}[2026/08/05 v0.1.0 Educational environments]

\RequirePackage{amsthm}
\RequirePackage[most]{tcolorbox}

\newtheoremstyle{unipd-plain}
  {0.6em}{0.6em}{\itshape}{}%
  {\sffamily\bfseries\color{black}}{.}{0.5em}{}
\newtheoremstyle{unipd-definition}
  {0.6em}{0.6em}{\normalfont}{}%
  {\sffamily\bfseries\color{black}}{.}{0.5em}{}
\newtheoremstyle{unipd-remark}
  {0.6em}{0.6em}{\normalfont}{}%
  {\sffamily\bfseries\color{black}}{.}{0.5em}{}
\newtheoremstyle{unipd-warning}
  {0.6em}{0.6em}{\normalfont}{}%
  {\sffamily\bfseries}{.}{0.5em}%
  {\thmname{\color{unipd-warning}#1}%
   \thmnumber{\color{unipd-warning}\nobreakspace#2}%
   \thmnote{\color{black}\nobreakspace(#3)}}

\theoremstyle{unipd-plain}
\newtheorem{theorem}{\unipdtranslate{theorem}}[chapter]
\newtheorem{proposition}{\unipdtranslate{proposition}}[chapter]
\newtheorem{lemma}{\unipdtranslate{lemma}}[chapter]
\newtheorem{corollary}{\unipdtranslate{corollary}}[chapter]

\theoremstyle{unipd-definition}
\newtheorem{definition}{\unipdtranslate{definition}}[chapter]
\newtheorem{example}{\unipdtranslate{example}}[chapter]
\newtheorem{important}{\unipdtranslate{important}}[chapter]
\newtheorem{exercise}{\unipdtranslate{exercise}}[chapter]
\newtheorem{solution}{\unipdtranslate{solution}}[chapter]

\theoremstyle{unipd-remark}
\newtheorem{remark}{\unipdtranslate{remark}}[chapter]

\theoremstyle{unipd-warning}
\newtheorem{warning}{\unipdtranslate{warning}}[chapter]

\tcbset{
  unipd statement/.style={
    enhanced,
    breakable,
    sharp corners,
    boxrule=0pt,
    leftrule=2pt,
    colback=unipd-soft,
    colframe=unipd-accent,
    left=9pt,
    right=9pt,
    top=6pt,
    bottom=6pt,
    before skip=0.8em,
    after skip=0.8em
  },
  unipd callout/.style={
    unipd statement,
    colframe=unipd-warning,
    colback=unipd-code-bg
  }
}

\tcolorboxenvironment{definition}{unipd statement}
\tcolorboxenvironment{theorem}{unipd statement}
\tcolorboxenvironment{proposition}{unipd statement}
\tcolorboxenvironment{lemma}{unipd statement}
\tcolorboxenvironment{corollary}{unipd statement}
\tcolorboxenvironment{example}{unipd statement}
\tcolorboxenvironment{remark}{unipd statement}
\tcolorboxenvironment{important}{unipd statement}
\tcolorboxenvironment{warning}{unipd callout}
\tcolorboxenvironment{exercise}{unipd statement}
\tcolorboxenvironment{solution}{unipd statement}

\addto\captionsitalian{%
  \renewcommand{\proofname}{\unipdtranslate{proof}}}
\addto\captionsenglish{%
  \renewcommand{\proofname}{\unipdtranslate{proof}}}

\endinput

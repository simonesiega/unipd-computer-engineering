  \unipdtranslate{changes} \\\midrule
  \endfirsthead
  \toprule
  \unipdtranslate{version} & \unipdtranslate{date} &
  \unipdtranslate{changes} \\\midrule
  \endhead
  \bottomrule
  \endfoot
}{%
  \end{longtable}
}

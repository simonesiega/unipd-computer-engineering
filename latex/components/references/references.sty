\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{\@currpath\@currname}[2026/07/31 v0.1.0 References and optional bibliography]

\ifunipdbibliography
  \RequirePackage[
    backend=biber,
    style=authoryear,
    sorting=nyt,
    giveninits=true,
    maxbibnames=99
  ]{biblatex}
\fi

\newcommand*{\unipdcrefnames}[3]{%
  \crefname{#1}
    {\unipdtranslate{#2-lower}}
    {\unipdtranslate{#3-lower}}%
  \Crefname{#1}
    {\unipdtranslate{#2-upper}}
    {\unipdtranslate{#3-upper}}%
}
\unipdcrefnames{chapter}{chapter}{chapters}
\unipdcrefnames{section}{section}{sections}
\unipdcrefnames{subsection}{subsection}{subsections}
\unipdcrefnames{equation}{equation}{equations}
\unipdcrefnames{figure}{figure}{figures}
\unipdcrefnames{table}{table}{tables}
\unipdcrefnames{lstlisting}{listing}{listings}
\unipdcrefnames{listing}{listing}{listings}
\unipdcrefnames{algocf}{algorithm}{algorithms}
\unipdcrefnames{algorithm}{algorithm}{algorithms}
\unipdcrefnames{definition}{definition}{definitions}
\unipdcrefnames{theorem}{theorem}{theorems}
\unipdcrefnames{proposition}{proposition}{propositions}
\unipdcrefnames{lemma}{lemma}{lemmas}
\unipdcrefnames{corollary}{corollary}{corollaries}
\unipdcrefnames{example}{example}{examples}
\unipdcrefnames{remark}{remark}{remarks}
\unipdcrefnames{important}{important}{importants}
\unipdcrefnames{warning}{warning}{warnings}
\unipdcrefnames{exercise}{exercise}{exercises}
\unipdcrefnames{solution}{solution}{solutions}

\ifunipdbibliography
  \DefineBibliographyStrings{italian}
    {bibliography={\unipdtranslate{bibliography}}}
  \DefineBibliographyStrings{english}
    {bibliography={\unipdtranslate{bibliography}}}
  \NewDocumentCommand{\printcoursebibliography}{}{%
    \printbibliography[heading=bibintoc,title={\unipdtranslate{bibliography}}]%
  }
\else
  \NewDocumentCommand{\printcoursebibliography}{}{}
\fi


\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{\@currpath\@currname}[2026/08/05 v0.1.0 References and optional bibliography]

\ifunipdbibliography
  \RequirePackage[
    backend=biber,
    style=authoryear,
    sorting=nyt,
    giveninits=true,
    uniquename=init,
    maxbibnames=99
  ]{biblatex}
\fi
\RequirePackage[nameinlink,noabbrev]{cleveref}

\newcommand*{\unipd@crefnames}[3]{%
  \crefname{#1}
    {\unipdtranslate{#2-lower}}
    {\unipdtranslate{#3-lower}}%
  \Crefname{#1}
    {\unipdtranslate{#2-upper}}
    {\unipdtranslate{#3-upper}}%
}
\unipd@crefnames{chapter}{chapter}{chapters}
\unipd@crefnames{section}{section}{sections}
\unipd@crefnames{subsection}{subsection}{subsections}
\unipd@crefnames{equation}{equation}{equations}
\unipd@crefnames{figure}{figure}{figures}
\unipd@crefnames{table}{table}{tables}
\unipd@crefnames{listing}{listing}{listings}
\unipd@crefnames{algorithm}{algorithm}{algorithms}
\unipd@crefnames{definition}{definition}{definitions}
\unipd@crefnames{theorem}{theorem}{theorems}
\unipd@crefnames{proposition}{proposition}{propositions}
\unipd@crefnames{lemma}{lemma}{lemmas}
\unipd@crefnames{corollary}{corollary}{corollaries}
\unipd@crefnames{example}{example}{examples}
\unipd@crefnames{remark}{remark}{remarks}
\unipd@crefnames{important}{important}{importants}
\unipd@crefnames{warning}{warning}{warnings}
\unipd@crefnames{exercise}{exercise}{exercises}
\unipd@crefnames{solution}{solution}{solutions}

\ifunipdbibliography
  \DefineBibliographyStrings{italian}
    {bibliography={\unipdtranslate{bibliography}}}
  \DefineBibliographyStrings{english}
    {bibliography={\unipdtranslate{bibliography}}}
  \NewDocumentCommand{\printcoursebibliography}{}{%
    \printbibliography[heading=bibintoc,title={\unipdtranslate{bibliography}}]%
  }
\else
  \NewDocumentCommand{\printcoursebibliography}{}{}
\fi

\endinput

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{\@currpath\@currname}[2026/08/01 v0.1.0 Glossary and acronyms]

\RequirePackage[acronym,toc,nonumberlist,nopostdot,nowarn]{glossaries-extra}
\makenoidxglossaries
\setabbreviationstyle[acronym]{long-short}
\renewcommand*{\glstextformat}[1]{\textcolor{unipd-accent}{#1}}
\renewcommand*{\glossarysection}[2][]{\chapter*{#2}\addcontentsline{toc}{chapter}{#2}}
\newglossarystyle{unipd-long}{%
  \setglossarystyle{long}%
  \renewenvironment{theglossary}%
    {\setlength{\LTpre}{0pt}\begin{longtable}{lp{\glsdescwidth}}}%
    {\end{longtable}}%
  \renewcommand*{\glsgroupskip}{}%
}
\setglossarystyle{unipd-long}
\setlength{\glsdescwidth}{0.72\linewidth}

\NewDocumentCommand{\newcourseacronym}{mmm}{\newacronym{#1}{#2}{#3}}
\NewDocumentCommand{\newcourseterm}{mmm}{\newglossaryentry{#1}{name={#2},description={#3}}}
\NewDocumentCommand{\printcourseglossary}{}{%
  \printnoidxglossary[title={Glossario}]%
  \printnoidxglossary[type=\acronymtype,title={Acronimi}]%
}


\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{\@currpath\@currname}[2026/09/10 v0.1.1 Glossary and acronyms]

\RequirePackage[acronym,toc,nonumberlist,nopostdot]{glossaries-extra}
\newif\ifunipd@glossaryinitialized
\unipd@glossaryinitializedfalse
\newcommand*{\unipd@initializeglossaries}{%
  \ifunipd@glossaryinitialized\else
    \global\unipd@glossaryinitializedtrue
    \makenoidxglossaries
  \fi
}
\setabbreviationstyle[acronym]{long-short}
\renewcommand*{\glstextformat}[1]{\textcolor{unipd-accent}{#1}}
\renewcommand*{\glossarysection}[2][]{\chapter*{#2}\addcontentsline{toc}{chapter}{#2}}
\newglossarystyle{unipd-long}{%
  \setglossarystyle{long}%
  \renewenvironment{theglossary}%
    {\setlength{\LTpre}{0pt}\begin{longtable}{lp{\glsdescwidth}}}%
    {\end{longtable}}%
  \renewcommand*{\glsgroupskip}{}%
}
\setglossarystyle{unipd-long}
\setlength{\glsdescwidth}{0.72\linewidth}

\NewDocumentCommand{\newcourseacronym}{mmm}{%
  \unipd@initializeglossaries
  \newacronym{#1}{#2}{#3}%
}
\NewDocumentCommand{\newcourseterm}{mmm}{%
  \unipd@initializeglossaries
  \newglossaryentry{#1}{name={#2},description={#3}}%
}
\NewDocumentCommand{\printcourseglossary}{}{%
  \ifunipd@glossaryinitialized
    \printnoidxglossary[title={\unipdtranslate{glossary}}]%
    \printnoidxglossary[type=\acronymtype,title={\unipdtranslate{acronyms}}]%
  \fi
}

\endinput

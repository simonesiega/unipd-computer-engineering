\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{\@currpath\@currname}[2026/08/05 v0.1.0 Code listings]

\RequirePackage{listings}
\RequirePackage{upquote}

\newcommand*{\unipdlistingcaptions}{%
  \renewcommand{\lstlistingname}{\unipdtranslate{listing}}%
  \renewcommand{\lstlistlistingname}{\unipdtranslate{list-of-listings}}}
\addto\captionsitalian{\unipdlistingcaptions}
\addto\captionsenglish{\unipdlistingcaptions}

\lstdefinelanguage{JavaScript}{
  keywords={break,case,const,continue,default,delete,do,else,export,false,for,function,if,import,in,let,new,null,return,switch,true,typeof,var,while},
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
  morestring=[b]'
}

\lstdefinestyle{unipd-code}{
  basicstyle=\ttfamily\fontsize{9.5pt}{12pt}\selectfont,
  keywordstyle=\unipdmonomedium\color{unipd-primary},
  commentstyle=\itshape\color{unipd-muted!80!black},
  stringstyle=\color{unipd-warning},
  numbers=left,
  numberstyle=\ttfamily\color{unipd-muted!75!black},
  stepnumber=1,
  firstnumber=1,
  numbersep=7pt,
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  tabsize=2,
  frame=single,
  framerule=0.4pt,
  rulecolor=\color{unipd-rule},
  backgroundcolor=\color{unipd-code-bg},
  xleftmargin=2.5em,
  xrightmargin=0.5em,
  framexleftmargin=2em,
  captionpos=b,
  aboveskip=0.8em,
  belowskip=0.8em,
  literate=
    {à}{{\`a}}1 {á}{{\'a}}1 {â}{{\^a}}1 {ä}{{\"a}}1
    {ã}{{\~a}}1 {å}{{\r a}}1 {æ}{{\ae}}1 {ç}{{\c c}}1
    {è}{{\`e}}1 {é}{{\'e}}1 {ê}{{\^e}}1 {ë}{{\"e}}1
    {ì}{{\`i}}1 {í}{{\'i}}1 {î}{{\^i}}1 {ï}{{\"i}}1
    {ñ}{{\~n}}1 {ò}{{\`o}}1 {ó}{{\'o}}1 {ô}{{\^o}}1
    {ö}{{\"o}}1 {õ}{{\~o}}1 {ø}{{\o}}1 {œ}{{\oe}}1
    {ù}{{\`u}}1 {ú}{{\'u}}1 {û}{{\^u}}1 {ü}{{\"u}}1
    {ý}{{\'y}}1 {ÿ}{{\"y}}1 {ß}{{\ss}}1
    {À}{{\`A}}1 {Á}{{\'A}}1 {Â}{{\^A}}1 {Ä}{{\"A}}1
    {Ã}{{\~A}}1 {Å}{{\r A}}1 {Æ}{{\AE}}1 {Ç}{{\c C}}1
    {È}{{\`E}}1 {É}{{\'E}}1 {Ê}{{\^E}}1 {Ë}{{\"E}}1
    {Ì}{{\`I}}1 {Í}{{\'I}}1 {Î}{{\^I}}1 {Ï}{{\"I}}1
    {Ñ}{{\~N}}1 {Ò}{{\`O}}1 {Ó}{{\'O}}1 {Ô}{{\^O}}1
    {Ö}{{\"O}}1 {Õ}{{\~O}}1 {Ø}{{\O}}1 {Œ}{{\OE}}1
    {Ù}{{\`U}}1 {Ú}{{\'U}}1 {Û}{{\^U}}1 {Ü}{{\"U}}1
    {Ý}{{\'Y}}1 {Ÿ}{{\"Y}}1
    {‘}{{\textquoteleft}}1 {’}{{\textquoteright}}1
    {“}{{\textquotedblleft}}1 {”}{{\textquotedblright}}1
    {–}{{\textendash}}1 {—}{{\textemdash}}1 {…}{{\ldots}}1
}

\lstdefinestyle{unipd-terminal}{
  style=unipd-code,
  language={},
  keywordstyle=\color{unipd-primary},
  commentstyle=\color{unipd-muted!80!black},
  stringstyle=\color{unipd-primary}
}

\lstnewenvironment{code}[1][]
  {\lstset{style=unipd-code,#1}}
  {}
\lstnewenvironment{terminal}[1][]
  {\lstset{style=unipd-terminal,#1}}
  {}


    document-type   .code:n = \unipd_metadata_set:nn { document-type } {#1},
    author          .code:n = \unipd_metadata_set:nn { author } {#1},
    date            .code:n = \unipd_metadata_set:nn { date } {#1},
    version         .code:n = \unipd_metadata_set:nn { version } {#1},
    university      .code:n = \unipd_metadata_set:nn { university } {#1},
    degree          .code:n = \unipd_metadata_set:nn { degree } {#1},
    repository      .code:n = \unipd_metadata_set:nn { repository } {#1},
    license         .code:n = \unipd_metadata_set:nn { license } {#1},
    unofficial-notice .code:n =
      \unipd_metadata_set:nn { unofficial-notice } {#1}
  }

\NewDocumentCommand{\unipdsetup}{m}
  { \keys_set:nn { unipd/metadata } {#1} }

\NewExpandableDocumentCommand{\unipdmetadata}{m}
  { \prop_item:Nn \g_unipd_metadata_prop {#1} }

\NewDocumentCommand{\unipdifmetadata}{m +m +m}
  {
    \tl_if_blank:eTF
      { \prop_item:Nn \g_unipd_metadata_prop {#1} }
      {#3}
      {#2}
  }

\NewExpandableDocumentCommand{\unipdheadcourse}{}
  {
    \tl_if_blank:eTF
      { \prop_item:Nn \g_unipd_metadata_prop { short-course } }
      { \prop_item:Nn \g_unipd_metadata_prop { course } }
      { \prop_item:Nn \g_unipd_metadata_prop { short-course } }
  }

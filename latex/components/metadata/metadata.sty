\cs_new_protected:Npn \unipd_metadata_set:nn #1#2
  { \prop_gput:Nnn \g_unipd_metadata_prop {#1} {#2} }

\clist_map_inline:nn
  {
    course, short-course, professor, academic-year, degree-year, semester,
    document-type, date, version
  }
  { \unipd_metadata_set:nn {#1} {} }

\exp_args:Nne \unipd_metadata_set:nn
  { university } { \unipdtranslate{university} }
\exp_args:Nne \unipd_metadata_set:nn
  { degree } { \unipdtranslate{degree} }
\unipd_metadata_set:nn { author } { Simone~Siega }
\unipd_metadata_set:nn { repository } { Computer~Engineering~—~UniPD }
\unipd_metadata_set:nn { license } { CC~BY-SA~4.0 }
\exp_args:Nne \unipd_metadata_set:nn
  { unofficial-notice } { \unipdtranslate{unofficial-notice} }

\keys_define:nn { unipd/metadata }
  {
    course          .code:n = \unipd_metadata_set:nn { course } {#1},
    short-course    .code:n = \unipd_metadata_set:nn { short-course } {#1},
    professor       .code:n = \unipd_metadata_set:nn { professor } {#1},
    academic-year   .code:n = \unipd_metadata_set:nn { academic-year } {#1},
    degree-year     .code:n = \unipd_metadata_set:nn { degree-year } {#1},
